#!/bin/bash

pkill -9 -f '/home/perpetual/git/perpetual_os/perpetual_hardware/.venv/bin/python'
pkill -9 -f "node .*vite"
docker compose -f docker-compose.standalone.yml stop nats

docker compose -f docker-compose.standalone.yml up -d nats

cd ./openshelf_os1
nohup npm run dev 2>&1 &

cd ../perpetual_hardware/packages/perpetual_os1_server
NATS_DOMAIN=localhost /home/perpetual/.local/bin/uv run start


