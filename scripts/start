#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
DATA_DIR="$SCRIPT_DIR/openshelf_hardware/data"

MODE_FILE="$DATA_DIR/.mode"
LAST_MODE_FILE="$DATA_DIR/.last_start_mode"

HARDWARE=false
BUILD=false
PULL=false
PULL_NEEDED=false
FORCE_RECREATE=false
DETACHED=false
MODE=""
CONFIG_OVERRIDE_HOST_PATH=""
CONTAINER_DATA_DIR="/app/openshelf_hardware/data"

read_group_id() {
	group_name="$1"
	group_entry=""
	group_id=""

	group_entry="$(getent group "$group_name" 2>/dev/null || true)"

	if [[ -z "$group_entry" ]]; then
		return 0
	fi

	IFS=':' read -r _ _ group_id _ <<< "$group_entry"
	printf "%s\n" "$group_id"
}

export_container_runtime_env() {
	export OPSHELF_UID="$(id -u)"
	export OPSHELF_GID="$(id -g)"

	group_id="$(read_group_id dialout)"
	if [[ -n "$group_id" ]]; then
		export OPSHELF_DIALOUT_GID="$group_id"
	fi

	group_id="$(read_group_id video)"
	if [[ -n "$group_id" ]]; then
		export OPSHELF_VIDEO_GID="$group_id"
	fi

	group_id="$(read_group_id input)"
	if [[ -n "$group_id" ]]; then
		export OPSHELF_INPUT_GID="$group_id"
	fi

	group_id="$(read_group_id render)"
	if [[ -n "$group_id" ]]; then
		export OPSHELF_RENDER_GID="$group_id"
	fi
}

# docker-compose.yml used to default JWT_SECRET and AUDIT_HMAC_KEY to literals that
# are in the repository, so any stack started without an explicit secret signed
# tokens and audit rows with a published key, and that key got persisted into
# config.<mode>.json on save. One key pair per mode is generated instead and kept
# in the mode data directory (0600, gitignored, alongside the config that already
# holds a jwt_secret) so tokens and audit rows survive restarts.
INSECURE_PUBLISHED_SECRETS=("INSECURE_JWT_SECRET" "INSECURE_AUDIT_HMAC_KEY")
RUNTIME_SECRETS_FILE=""

is_published_default_secret() {
	local candidate="$1"
	local published=""

	for published in "${INSECURE_PUBLISHED_SECRETS[@]}"; do
		if [[ "$candidate" == "$published" ]]; then
			return 0
		fi
	done

	return 1
}

read_secret_value() {
	awk -F= -v key="$2" '$1 == key { sub("^[^=]*=", ""); print; exit }' "$1"
}

generate_runtime_secret() {
	python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
}

# The id minted for a generated audit key: production keeps the stable v2 id,
# other modes get v2-<mode>.
generated_audit_key_id() {
	if [[ "$MODE" == "production" ]]; then
		printf "v2"
		return 0
	fi

	printf "v2-%s" "$MODE"
}

write_runtime_secrets_file() {
	local path="$1"
	local content="$2"
	local temp_file=""

	if ! mkdir -p "$(dirname "$path")"; then
		return 1
	fi

	temp_file="$(mktemp "${path}.XXXXXX")" || return 1

	if ! printf "%s" "$content" > "$temp_file"; then
		rm -f "$temp_file"
		return 1
	fi

	if ! mv -f "$temp_file" "$path"; then
		rm -f "$temp_file"
		return 1
	fi
}

# Preserve a secrets file that is about to lose its AUDIT_HMAC_KEY: audit rows
# already signed with the superseded key can only be verified while that key is
# kept, so the file is copied to a 0600 archive beside the live one before the
# rewrite instead of being deleted by it. A timestamp collision reuses the
# existing archive name rather than failing.
archive_superseded_runtime_secrets() {
	local path="$1"
	local key_id="$2"
	local archive_path=""
	local timestamp=""

	timestamp="$(date -u +%Y%m%dT%H%M%SZ)" || return 1
	archive_path="${path}.retired-${timestamp}"

	if ! cp "$path" "$archive_path"; then
		echo "Failed to archive superseded runtime secrets: $archive_path" >&2
		return 1
	fi

	if ! chmod 600 "$archive_path"; then
		echo "Failed to set mode 0600 on the archived runtime secrets: $archive_path" >&2
		return 1
	fi

	echo "WARNING: the AUDIT_HMAC_KEY in ${path##*/} is being superseded; audit rows already signed with it (key id ${key_id:-none}) can no longer be verified automatically" >&2
	echo "WARNING: the archive is the operator's only way back to the superseded key: $archive_path (mode 0600)" >&2
}

ensure_runtime_secrets() {
	RUNTIME_SECRETS_FILE="$DATA_DIR/.secrets.$MODE"
	local env_jwt="${JWT_SECRET:-}"
	local env_audit_key="${AUDIT_HMAC_KEY:-}"
	local file_jwt=""
	local file_audit_key=""
	local file_audit_id=""
	local content=""

	if [[ -f "$RUNTIME_SECRETS_FILE" ]]; then
		file_jwt="$(read_secret_value "$RUNTIME_SECRETS_FILE" JWT_SECRET)"
		file_audit_key="$(read_secret_value "$RUNTIME_SECRETS_FILE" AUDIT_HMAC_KEY)"
		file_audit_id="$(read_secret_value "$RUNTIME_SECRETS_FILE" AUDIT_HMAC_KEY_ID)"
	fi

	if is_published_default_secret "$env_jwt"; then
		echo "JWT_SECRET is a published default, using a generated per-mode key instead" >&2
		env_jwt=""
	fi

	if is_published_default_secret "$env_audit_key"; then
		echo "AUDIT_HMAC_KEY is a published default, using a generated per-mode key instead" >&2
		env_audit_key=""
	fi

	# A replaced audit key must carry a new key id, otherwise rows signed with the
	# previous key are checked against the new one and read as tampering. A
	# generated key's id is mode-scoped (generated_audit_key_id) for the same
	# reason: a mode's first database is a whole-file copy of production's
	# audit history, so if every mode minted the same id, the copied rows --
	# signed under the source mode's key -- would match this mode's key id and
	# read as a plain HMAC mismatch instead of the distinct
	# "no key available" verdict.
	if [[ -z "$env_audit_key" && -n "$file_audit_key" ]] && ! is_published_default_secret "$file_audit_key"; then
		env_audit_key="$file_audit_key"
		export AUDIT_HMAC_KEY_ID="${AUDIT_HMAC_KEY_ID:-$file_audit_id}"
	elif [[ -z "$env_audit_key" ]]; then
		env_audit_key="$(generate_runtime_secret)" || return 1
		export AUDIT_HMAC_KEY_ID="${AUDIT_HMAC_KEY_ID:-$(generated_audit_key_id)}"
	else
		export AUDIT_HMAC_KEY_ID="${AUDIT_HMAC_KEY_ID:-}"
	fi

	if [[ -z "$env_jwt" ]]; then
		env_jwt="$file_jwt"
		if [[ -z "$env_jwt" ]]; then
			env_jwt="$(generate_runtime_secret)" || return 1
		fi
	fi

	export JWT_SECRET="$env_jwt"
	export AUDIT_HMAC_KEY="$env_audit_key"

	content="JWT_SECRET=$JWT_SECRET"$'\n'"AUDIT_HMAC_KEY=$AUDIT_HMAC_KEY"$'\n'"AUDIT_HMAC_KEY_ID=${AUDIT_HMAC_KEY_ID}"$'\n'

	# Command substitution strips trailing newlines, so compare against the content
	# without its trailing newline; an unchanged file takes the no-op path below.
	if [[ "$(cat "$RUNTIME_SECRETS_FILE" 2>/dev/null)" != "${content%$'\n'}" ]]; then
		if [[ -n "$file_audit_key" && "$file_audit_key" != "$AUDIT_HMAC_KEY" ]]; then
			if ! archive_superseded_runtime_secrets "$RUNTIME_SECRETS_FILE" "$file_audit_id"; then
				return 1
			fi
		fi

		if ! write_runtime_secrets_file "$RUNTIME_SECRETS_FILE" "$content"; then
			echo "Failed to write runtime secrets file: $RUNTIME_SECRETS_FILE" >&2
			return 1
		fi
	fi
}

write_mode_file() {
	local path="$1"
	local value="$2"
	local parent_dir=""
	local temp_file=""

	parent_dir="$(dirname "$path")"
	mkdir -p "$parent_dir" || return 1

	temp_file="$(mktemp "$parent_dir/.tmp.XXXXXX")" || return 1

	if ! printf "%s" "$value" > "$temp_file"; then
		rm -f "$temp_file"
		return 1
	fi

	if ! mv -f "$temp_file" "$path"; then
		rm -f "$temp_file"
		return 1
	fi
}

prepare_config_path_override() {
	local configured_path="${OPENSHELF_CONFIG_PATH:-}"
	local resolved_path=""
	local resolved_data_dir=""

	CONFIG_OVERRIDE_HOST_PATH=""
	[[ -n "$configured_path" ]] || return 0

	if [[ "$configured_path" == "$CONTAINER_DATA_DIR" || "$configured_path" == "$CONTAINER_DATA_DIR/"* ]]; then
		configured_path="$DATA_DIR${configured_path#$CONTAINER_DATA_DIR}"
	fi

	resolved_path="$(python3 - "$configured_path" "$PWD" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
if path.is_absolute() is False:
    path = Path(sys.argv[2]) / path
print(path.resolve())
PY
)"
	resolved_data_dir="$(python3 - "$DATA_DIR" <<'PY'
from pathlib import Path
import sys

print(Path(sys.argv[1]).resolve())
PY
)"
	CONFIG_OVERRIDE_HOST_PATH="$resolved_path"

	if [[ "$resolved_path" == "$resolved_data_dir" || "$resolved_path" == "$resolved_data_dir/"* ]]; then
		OPENSHELF_CONFIG_PATH="$CONTAINER_DATA_DIR${resolved_path#$resolved_data_dir}"
		export OPENSHELF_CONFIG_PATH
		return 0
	fi

	echo "OPENSHELF_CONFIG_PATH must be inside $resolved_data_dir; external host paths are not supported" >&2
	return 1
}

is_hardware_expected() {
	local mode_config="$DATA_DIR/config.json"
	if [[ "$MODE" != "production" ]]; then
		mode_config="$DATA_DIR/config.$MODE.json"
	fi

	python3 - "$CONFIG_OVERRIDE_HOST_PATH" "$mode_config" "$DATA_DIR/config.json" "$DATA_DIR/settings.json" <<'PY'
import json
import sys

for path in sys.argv[1:]:
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        continue

    if not isinstance(data, dict):
        sys.exit(1)

    robot_app = data.get("robot_app")
    if isinstance(robot_app, dict) and robot_app.get("enabled") is True:
        sys.exit(0)

    robot = data.get("robot")
    if isinstance(robot, dict) and robot.get("enabled") is True:
        sys.exit(0)

    # The selected mode's first valid config is authoritative, including when
    # it explicitly disables hardware.
    sys.exit(1)

sys.exit(1)
PY
}

while [[ $# -gt 0 ]]; do
	case $1 in
		-h|--hardware)
			HARDWARE=true
			shift
			;;
		-b|--build)
			BUILD=true
			shift
			;;
		-p|--pull)
			PULL=true
			shift
			;;
		--force-recreate)
			FORCE_RECREATE=true
			shift
			;;
		-d|--detached)
			DETACHED=true
			shift
			;;
		-m|--mode)
			MODE="$2"
			shift 2
			;;
		*)
			echo "Unknown option: $1"
			echo "Usage: $0 [-h|--hardware] [-b|--build] [-p|--pull] [--force-recreate] [-d|--detached] [-m|--mode demo|development|mock|production]"
			exit 1
			;;
	esac
done

PULL_NEEDED="$PULL"

if [[ -z "$MODE" ]]; then
	if [[ -f "$MODE_FILE" ]]; then
		MODE=$(cat "$MODE_FILE" | tr -d '[:space:]')
	fi
fi

if [[ -z "$MODE" ]]; then
	MODE="production"
fi

case "$MODE" in
	demo|development|mock|production) ;;
	*)
		echo "Invalid mode: $MODE (must be demo, development, mock, or production)"
		exit 1
		;;
esac

if ! prepare_config_path_override; then
	exit 1
fi

if ! write_mode_file "$MODE_FILE" "$MODE"; then
	echo "Failed to write mode file: $MODE_FILE"
	exit 1
fi

export OPERATING_MODE="$MODE"
export DEPLOYMENT_ENVIRONMENT="$MODE"
export SENTRY_ENVIRONMENT="$MODE"

case "$MODE" in
	development)
		export ENV=dev
		;;
	demo|mock|production)
		export ENV=production
		;;
esac

if ! ensure_runtime_secrets; then
	echo "Failed to provision signing secrets for mode: $MODE" >&2
	exit 1
fi

LAST_MODE=""
if [[ -f "$LAST_MODE_FILE" ]]; then
	LAST_MODE=$(cat "$LAST_MODE_FILE" | tr -d '[:space:]')
fi

if [[ -n "$LAST_MODE" && "$LAST_MODE" != "$MODE" && "$BUILD" == false ]]; then
	LAST_IS_DEV=$([[ "$LAST_MODE" == "development" ]] && echo true || echo false)
	CURR_IS_DEV=$([[ "$MODE" == "development" ]] && echo true || echo false)

	if [[ "$LAST_IS_DEV" != "$CURR_IS_DEV" ]]; then
		if [[ "$PULL" == true ]]; then
			echo "mode switch ($LAST_MODE -> $MODE) crosses build boundary, pulling prebuilt images"
			PULL_NEEDED=true
		else
			echo "mode switch ($LAST_MODE -> $MODE) crosses build boundary, forcing rebuild"
			BUILD=true
		fi
	fi
fi

if [[ "$MODE" != "mock" && "$HARDWARE" == false ]] && is_hardware_expected; then
	HARDWARE=true
	echo "hardware config detected; enabling docker-compose.hardware.yml"
fi

echo "starting in $MODE mode"

export_container_runtime_env

COMPOSE_FILES="-f docker-compose.yml"

if [[ "$MODE" == "development" ]]; then
	COMPOSE_FILES="$COMPOSE_FILES -f docker-compose.dev.yml"
fi

if [[ "$HARDWARE" == true ]]; then
	COMPOSE_FILES="$COMPOSE_FILES -f docker-compose.hardware.yml"
fi

COMPOSE_CMD="docker compose $COMPOSE_FILES"

if [[ "$PULL_NEEDED" == true ]]; then
	images="$(cd "$SCRIPT_DIR" && eval "$COMPOSE_CMD config --images" 2>/dev/null || true)"
	for image in $images; do
		if ! docker pull "$image"; then
			echo "failed to pull $image; start aborted (check network and rerun)" >&2
			exit 1
		fi
	done
fi

if [[ "$BUILD" == true ]]; then
	COMPOSE_CMD="$COMPOSE_CMD up --build --remove-orphans"
else
	COMPOSE_CMD="$COMPOSE_CMD up --no-build --remove-orphans"
fi

if [[ "$FORCE_RECREATE" == true ]]; then
	COMPOSE_CMD="$COMPOSE_CMD --force-recreate"
fi

if [[ "$DETACHED" == true ]]; then
	COMPOSE_CMD="$COMPOSE_CMD -d"
fi

if ! write_mode_file "$LAST_MODE_FILE" "$MODE"; then
	echo "Failed to write mode tracking file: $LAST_MODE_FILE"
	exit 1
fi
cd "$SCRIPT_DIR" && eval $COMPOSE_CMD
