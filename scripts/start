#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
DATA_DIR="$SCRIPT_DIR/perpetual_hardware/data"

MODE_FILE="$DATA_DIR/.mode"
LAST_MODE_FILE="$DATA_DIR/.last_start_mode"

HARDWARE=false
BUILD=false
DETACHED=false
MODE=""

write_mode_file() {
	local path="$1"
	local value="$2"
	local parent_dir=""
	local temp_file=""

	parent_dir="$(dirname "$path")"
	mkdir -p "$parent_dir" || return 1

	temp_file="$(mktemp "$parent_dir/.tmp.XXXXXX")" || return 1

	if ! printf "%s" "$value" > "$temp_file"; then
		rm -f "$temp_file"
		return 1
	fi

	if ! mv -f "$temp_file" "$path"; then
		rm -f "$temp_file"
		return 1
	fi
}

while [[ $# -gt 0 ]]; do
	case $1 in
		-h|--hardware)
			HARDWARE=true
			shift
			;;
		-b|--build)
			BUILD=true
			shift
			;;
		-d|--detached)
			DETACHED=true
			shift
			;;
		-m|--mode)
			MODE="$2"
			shift 2
			;;
		*)
			echo "Unknown option: $1"
			echo "Usage: $0 [-h|--hardware] [-b|--build] [-d|--detached] [-m|--mode demo|development|production]"
			exit 1
			;;
	esac
done

if [[ -z "$MODE" ]]; then
	if [[ -f "$MODE_FILE" ]]; then
		MODE=$(cat "$MODE_FILE" | tr -d '[:space:]')
	fi
fi

if [[ -z "$MODE" ]]; then
	MODE="production"
fi

case "$MODE" in
	demo|development|production) ;;
	*)
		echo "Invalid mode: $MODE (must be demo, development, or production)"
		exit 1
		;;
esac

if ! write_mode_file "$MODE_FILE" "$MODE"; then
	echo "Failed to write mode file: $MODE_FILE"
	exit 1
fi

case "$MODE" in
	demo)
		export ENV=dev
		export OPERATING_MODE=demo
		export SENTRY_ENVIRONMENT=demo
		;;
	development)
		export ENV=dev
		export OPERATING_MODE=development
		export SENTRY_ENVIRONMENT=development
		;;
	production)
		export ENV=production
		export OPERATING_MODE=production
		export SENTRY_ENVIRONMENT=production
		;;
esac

LAST_MODE=""
if [[ -f "$LAST_MODE_FILE" ]]; then
	LAST_MODE=$(cat "$LAST_MODE_FILE" | tr -d '[:space:]')
fi

if [[ -n "$LAST_MODE" && "$LAST_MODE" != "$MODE" && "$BUILD" == false ]]; then
	LAST_IS_DEV=$([[ "$LAST_MODE" == "development" ]] && echo true || echo false)
	CURR_IS_DEV=$([[ "$MODE" == "development" ]] && echo true || echo false)

	if [[ "$LAST_IS_DEV" != "$CURR_IS_DEV" ]]; then
		echo "mode switch ($LAST_MODE -> $MODE) crosses build boundary, forcing rebuild"
		BUILD=true
	fi
fi

echo "starting in $MODE mode"

COMPOSE_CMD="docker compose -f docker-compose.yml"

if [[ "$MODE" == "development" ]]; then
	COMPOSE_CMD="$COMPOSE_CMD -f docker-compose.dev.yml"
fi

if [[ "$HARDWARE" == true ]]; then
	COMPOSE_CMD="$COMPOSE_CMD -f docker-compose.hardware.yml"
fi

if [[ "$BUILD" == true ]]; then
	COMPOSE_CMD="$COMPOSE_CMD up --build --remove-orphans"
else
	COMPOSE_CMD="$COMPOSE_CMD up --remove-orphans"
fi

if [[ "$DETACHED" == true ]]; then
	COMPOSE_CMD="$COMPOSE_CMD -d"
fi

if ! write_mode_file "$LAST_MODE_FILE" "$MODE"; then
	echo "Failed to write mode tracking file: $LAST_MODE_FILE"
	exit 1
fi
cd "$SCRIPT_DIR" && eval $COMPOSE_CMD
