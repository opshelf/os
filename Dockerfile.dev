# The dev image is the production api image plus the dev dependency group, so a device
# that carries both shares every production layer. Releases pass the api image of the same
# commit; local builds start from the newest released one, and the sync below then matches
# the venv to this checkout's lock.
ARG BASE_IMAGE=registry.opshelf.com/opshelf/openshelf_os_api:latest
FROM ${BASE_IMAGE}

ENV UV_PYTHON=3.13
ENV UV_CACHE_DIR=/tmp/uv-cache

WORKDIR /app
COPY openshelf_hardware/ /app/openshelf_hardware/
WORKDIR /app/openshelf_hardware

# Same lock as the runtime image, plus the dev group; --frozen keeps uv from re-resolving.
# data/, EXPOSE and ENTRYPOINT come from the base image.
RUN uv sync --frozen --all-packages --group dev \
	&& rm -rf "$UV_CACHE_DIR"
