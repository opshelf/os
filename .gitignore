# Python caches and build artifacts. Regenerated by tooling anywhere in the tree,
# including inside each package, so these stay unanchored.
__pycache__/
*.py[oc]
build/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.uv-cache
.venv
# coverage.py writes these wherever the suite runs from, including openshelf_hardware/.
.coverage
.coverage.*
htmlcov/

# macOS metadata (unanchored patterns already match at any depth)
.DS_Store

# Runtime state: databases, mode files, calibration, scans, motion fault
# recorders, and per-mode config/storage/workspace files.
data/

# The device runtime environment that provisioning writes into the checkout.
.env

# Provisioned device configuration.
config.json
config.*.json

# Local docs scratch folders, at any depth, per team convention. The server's docs
# package is tracked Python code, so the negation keeps it visible; that package's own
# .gitignore still excludes its generated OpenAPI document.
docs/
!openshelf_hardware/packages/openshelf_os_server/docs/

# Agent instruction files and local agent settings.
.pi/*
!.pi/settings.json
CLAUDE.md
.claude/

# Editor settings stay local.
.vscode/

# Amp orb portal registrations.
.amp/portals/*
