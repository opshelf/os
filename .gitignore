# Python caches and build artifacts. Regenerated by tooling anywhere in the tree,
# including inside each package, so these stay unanchored.
__pycache__/
*.py[oc]
build/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.uv-cache
.venv

# macOS metadata (unanchored patterns already match at any depth)
.DS_Store

# Runtime state: databases, mode files, calibration, scans, motion fault
# recorders, and per-mode config/storage/workspace files.
#
# Unanchored on purpose. Each checkout resolves data dirs per package, so live
# state appears as data/ in more than one place (openshelf_hardware/data,
# openshelf_hardware/packages/openshelf_os_server/data), and an anchored rule
# would let a newly created one become committable.
data/

# Signing keys provisioned by scripts/start, one key file per mode plus its
# superseded archives. Listed explicitly so narrowing the rule above can never
# expose a JWT secret, an audit HMAC key, or an archived rotation.
.secrets.*

# Device configuration files. They already live under data/, and this rule is
# kept deliberately: ../backups and provisioned devices carry config.json files
# that persist auth.jwt_secret and audit_hmac_key, and those files get copied
# into a checkout to diff or calibrate. Nothing else here matches them.
config.json

# Local docs scratch folders, at any depth, per team convention. The tracked
# docs modules are re-included explicitly, because ignoring a directory hides
# everything inside it from `git add`: adding a new file to a docs package would
# otherwise require `git add -f`. docs/openapi.json remains ignored by that
# package's own .gitignore.
docs/
!openshelf_hardware/packages/openshelf_os_server/docs/

# Agent instruction files and local agent settings. `.pi/*` rather than `.pi/` so
# the negation below is effective: a negated file inside an excluded directory is
# unreachable, which is why the previous `.pi` + `!.pi/settings.json` pair was
# inert. `.claude` is listed here so it does not depend on any operator's global
# gitignore.
.pi/*
!.pi/settings.json
CLAUDE.md
.claude/
